# Copie para .env (cp .env.example .env) e preencha. O .env não vai para o git.

# Chave da API da Anthropic (crie em https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo do agente
LLM_MODEL=claude-haiku-5-5

# Postgres do Docker Compose
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha
# Senha do agent_reader, o usuário somente leitura usado pela api
AGENT_DB_PASSWORD=troque-esta-outra-senha
# Porta do banco no host (publicada só em 127.0.0.1)
POSTGRES_PORT=5433
