# Copy to .env (cp .env.example .env) and fill it in. The .env file never goes to git.

# Anthropic API key (create one at https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Model used by the agent
LLM_MODEL=claude-haiku-5-5

# Postgres of the Docker Compose
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
# Password of agent_reader, the read-only role used by the api
AGENT_DB_PASSWORD=change-me-too
# Password of review_writer, the role that only inserts the reviews a person approves
REVIEW_DB_PASSWORD=change-me-as-well
# Database port on the host (published on 127.0.0.1 only)
POSTGRES_PORT=5433
# Api port on the host (published on 127.0.0.1 only)
API_PORT=8000
